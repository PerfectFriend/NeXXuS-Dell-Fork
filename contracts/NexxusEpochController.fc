;; ==============================================================================
;; NeXXUs Protocol - TON Smart Contract: Epoch Controller (FunC)
;; Part III: Composite Genesis Trigger & Ed25519 M-of-N Multi-Sig Quorum Verifier
;; Fixes audit defect C-7 (genuine Ed25519 signature checks, no fake BLS).
;; ==============================================================================

#include "imports/stdlib.fc";

const int OP_TRIGGER_EPOCH = 0x7e1a0001;
const int OP_UPDATE_AUDITOR_SET = 0x7e1a0002;
const int OP_UPDATE_GENESIS_PARAMS = 0x7e1a0003;

const int ERROR_UNAUTHORIZED = 100;
const int ERROR_GENESIS_NOT_MET = 101;
const int ERROR_INSUFFICIENT_BOND = 102;
const int ERROR_INVALID_QUORUM = 103;
const int ERROR_EPOCH_TOO_EARLY = 104;
const int ERROR_INVALID_SIGNATURE = 105;
const int ERROR_DUPLICATE_SIGNER = 106;

;; Storage Scheme:
;; total_nodes: uint32
;; total_bond_nanotons: uint128
;; current_epoch: uint32
;; last_epoch_timestamp: uint64
;; genesis_timestamp: uint64
;; threshold: uint8 (M in M-of-N)
;; auditors_dict: cell (hashmap: uint256 ed25519_pubkey -> uint8 active)
;; treasury_vesting_address: slice
;; admin_address: slice

(int, int, int, int, int, int, cell, slice, slice) load_data() inline {
    slice ds = get_data().begin_parse();
    return (
        ds~load_uint(32),   ;; total_nodes
        ds~load_uint(128),  ;; total_bond_nanotons
        ds~load_uint(32),   ;; current_epoch
        ds~load_uint(64),   ;; last_epoch_timestamp
        ds~load_uint(64),   ;; genesis_timestamp
        ds~load_uint(8),    ;; threshold (M)
        ds~load_dict(),     ;; auditors_dict (ed25519 pubkeys)
        ds~load_msg_addr(), ;; treasury_vesting_address
        ds~load_msg_addr()  ;; admin_address
    );
}

() save_data(
    int total_nodes,
    int total_bond_nanotons,
    int current_epoch,
    int last_epoch_timestamp,
    int genesis_timestamp,
    int threshold,
    cell auditors_dict,
    slice treasury_vesting_address,
    slice admin_address
) impure inline {
    set_data(
        begin_cell()
            .store_uint(total_nodes, 32)
            .store_uint(total_bond_nanotons, 128)
            .store_uint(current_epoch, 32)
            .store_uint(last_epoch_timestamp, 64)
            .store_uint(genesis_timestamp, 64)
            .store_uint(threshold, 8)
            .store_dict(auditors_dict)
            .store_slice(treasury_vesting_address)
            .store_slice(admin_address)
        .end_cell()
    );
}

int calculate_emission_multiplier(int genesis_ts, int current_ts) inline {
    if (genesis_ts == 0) {
        return 0;
    }
    int elapsed_days = (current_ts - genesis_ts) / 86400;
    if (elapsed_days >= 180) {
        return 100;
    }
    return 5 + (95 * elapsed_days) / 180;
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) {
        return ();
    }

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    if (flags & 1) {
        return ();
    }
    slice sender_address = cs~load_msg_addr();

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    (
        int total_nodes,
        int total_bond_nanotons,
        int current_epoch,
        int last_epoch_timestamp,
        int genesis_timestamp,
        int threshold,
        cell auditors_dict,
        slice treasury_vesting_address,
        slice admin_address
    ) = load_data();

    ;; Admin operation: update auditor committee and threshold
    if (op == OP_UPDATE_AUDITOR_SET) {
        throw_unless(ERROR_UNAUTHORIZED, equal_slices(sender_address, admin_address));
        int new_threshold = in_msg_body~load_uint(8);
        cell new_auditors = in_msg_body~load_dict();
        save_data(
            total_nodes,
            total_bond_nanotons,
            current_epoch,
            last_epoch_timestamp,
            genesis_timestamp,
            new_threshold,
            new_auditors,
            treasury_vesting_address,
            admin_address
        );
        return ();
    }

    ;; Admin operation: update network size and total bond telemetry
    if (op == OP_UPDATE_GENESIS_PARAMS) {
        throw_unless(ERROR_UNAUTHORIZED, equal_slices(sender_address, admin_address));
        int new_nodes = in_msg_body~load_uint(32);
        int new_bonds = in_msg_body~load_uint(128);
        save_data(
            new_nodes,
            new_bonds,
            current_epoch,
            last_epoch_timestamp,
            genesis_timestamp,
            threshold,
            auditors_dict,
            treasury_vesting_address,
            admin_address
        );
        return ();
    }

    if (op == OP_TRIGGER_EPOCH) {
        int current_ts = now();
        throw_unless(ERROR_EPOCH_TOO_EARLY, current_ts >= last_epoch_timestamp + 86400);
        throw_unless(ERROR_GENESIS_NOT_MET, total_nodes >= 100);

        int min_required_bond = 100000000000000; ;; 100,000 TON
        throw_unless(ERROR_INSUFFICIENT_BOND, total_bond_nanotons >= min_required_bond);

        if (genesis_timestamp == 0) {
            genesis_timestamp = current_ts;
        }

        ;; Merkle root and total stored bytes finalized by epoch
        int epoch_merkle_root = in_msg_body~load_uint(256);
        int epoch_total_bytes = in_msg_body~load_uint(64);
        int sig_count = in_msg_body~load_uint(8);
        cell sigs_cell = in_msg_body~load_ref();
        slice sigs_slice = sigs_cell.begin_parse();

        ;; Canonical epoch signing data: SHA-256(epoch || merkle_root || total_bytes)
        slice epoch_data_to_sign = begin_cell()
            .store_uint(current_epoch + 1, 64)
            .store_uint(epoch_merkle_root, 256)
            .store_uint(epoch_total_bytes, 64)
        .end_cell().begin_parse();

        ;; Verify M-of-N Ed25519 signatures
        int valid_signatures = 0;
        cell seen_signers = new_dict();

        while (valid_signatures < sig_count) & (~ sigs_slice.slice_empty?()) {
            int auditor_pubkey = sigs_slice~load_uint(256);
            slice signature = sigs_slice~load_bits(512);

            ;; 1. Must be a registered auditor in committee
            (_, int found) = auditors_dict.udict_get?(256, auditor_pubkey);
            if (found) {
                ;; 2. Must not be a duplicate signature from the same auditor
                (_, int already_seen) = seen_signers.udict_get?(256, auditor_pubkey);
                if (~ already_seen) {
                    ;; 3. Check native TVM Ed25519 signature
                    if (check_data_signature(epoch_data_to_sign, signature, auditor_pubkey)) {
                        valid_signatures += 1;
                        seen_signers~udict_set_builder(256, auditor_pubkey, begin_cell().store_uint(1, 8));
                    }
                }
            }
        }

        throw_unless(ERROR_INVALID_QUORUM, valid_signatures >= threshold);

        int ramp_percent = calculate_emission_multiplier(genesis_timestamp, current_ts);
        int base_daily_emission = 10000000000000; ;; 10,000 NEXX
        int actual_epoch_emission = (base_daily_emission * ramp_percent) / 100;

        ;; Forward epoch rewards notification to NexxusTreasuryVesting
        var msg = begin_cell()
            .store_uint(0x18, 6)
            .store_slice(treasury_vesting_address)
            .store_coins(50000000) ;; 0.05 TON
            .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
            .store_uint(0x7e1b0001, 32) ;; OP_NOTIFY_EPOCH_REWARDS
            .store_uint(query_id, 64)
            .store_uint(current_epoch + 1, 32)
            .store_coins(actual_epoch_emission)
        .end_cell();

        send_raw_message(msg, 1);

        save_data(
            total_nodes,
            total_bond_nanotons,
            current_epoch + 1,
            current_ts,
            genesis_timestamp,
            threshold,
            auditors_dict,
            treasury_vesting_address,
            admin_address
        );
        return ();
    }

    throw(0xffff);
}

;; Get methods
(int, int, int, int, int, int) get_epoch_state() method_id {
    (
        int total_nodes,
        int total_bond_nanotons,
        int current_epoch,
        int last_epoch_timestamp,
        int genesis_timestamp,
        int threshold,
        _, _, _
    ) = load_data();
    return (total_nodes, total_bond_nanotons, current_epoch, last_epoch_timestamp, genesis_timestamp, threshold);
}
