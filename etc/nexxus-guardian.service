[Unit]
Description=NeXXus Guardian — хранитель Rust-ноды (следит за здоровьем, перезапускает)
Documentation=https://github.com/PerfectFriend/NeXXuS-Dell-Fork
After=network-online.target
Wants=network-online.target
# Хранитель стартует ПЕРВЫМ и сам тянет ноду за собой:
# нода не поднимется, пока guardian не отработал (Before=).
#
# Именно Wants, а не Requires: при Requires остановка ноды вручную
# останавливала бы и хранителя — а он как раз должен ноду вернуть.
Before=nexxus-rust-node.service
Wants=nexxus-rust-node.service

[Service]
Type=simple
User=root
Group=nexxus
WorkingDirectory=/opt/nexxus
Environment=NODE_ENV=production
Environment=NEXXUS_UNIT=nexxus-rust-node.service
Environment=NEXXUS_BIN=/usr/local/bin/nexxusd
Environment=NEXXUS_DATA_DIR=/var/lib/nexxus-rust
Environment=NEXXUS_PORT=4001
# Health-check идёт по WS-JSON-RPC прямо в ноду (nx-api.cjs сам авторизуется
# токеном). Запасной путь — REST control-plane.
Environment=NEXXUS_API_ADDR=127.0.0.1:4010
Environment=NEXXUS_API_TOKEN_FILE=/etc/nexxus-rust/api.token
Environment=NEXXUS_NX_API=/opt/nexxus/scripts/nx-api.cjs
Environment=NEXXUS_NODE_BIN=/usr/local/bin/node
Environment=NEXXUS_HEALTH_URL=http://127.0.0.1:3998/api/status
Environment=NEXXUS_CHECK_INTERVAL=15
Environment=NEXXUS_HEALTH_TIMEOUT=10
Environment=NEXXUS_MAX_FAILURES=3
Environment=NEXXUS_RESTART_COOLDOWN=60
Environment=NEXXUS_RECOVER_TIMEOUT=90
ExecStart=/opt/nexxus/scripts/nexxus-guardian.sh
Restart=always
RestartSec=10
# Хранитель перезапускает ноду через systemctl — ему нужен доступ к
# systemd-шине, но не нужен полный root доступ к файловой системе.
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexxus-guardian

# Sandbox: пишем только в каталог данных ноды.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/nexxus-rust

[Install]
WantedBy=multi-user.target
