[Unit]
Description=NeXXUs Sovereign Decentralized Storage Node Daemon
Documentation=https://github.com/PerfectFriend/NeXXuS-Dell-Fork
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Нода пишет в /var/lib/nexxus от root, но с группой nexxus — чтобы трей
# (пользователь master в группе nexxus) мог читать состояние и писать
# служебные файлы (пауза хранителя, тест-файл), не выдавая ноде лишних прав.
Group=nexxus
WorkingDirectory=/opt/nexxus
Environment=NODE_ENV=production
EnvironmentFile=-/etc/nexxus/nexxus.conf
Environment=NEXXUS_DATA_DIR=/var/lib/nexxus
# Путь к дашборду, который демон раздаёт сам (http://<host>:<port>/).
Environment=NEXXUS_DASHBOARD_DIR=/opt/nexxus/dashboard
# Файл конфигурации, который редактирует дашборд.
Environment=NEXXUS_CONFIG_FILE=/etc/nexxus/nexxus.conf
# Порт, пул и адрес прослушивания НЕ задаются флагами в ExecStart:
# иначе дашборд правил бы конфиг, а нода продолжала бы читать значения
# из аргументов командной строки, и изменения не применялись бы.
# Источник правды — /etc/nexxus/nexxus.conf через EnvironmentFile.
ExecStart=/usr/local/bin/nexxusd serve --data-dir=/var/lib/nexxus
Restart=always
RestartSec=5s
LimitNOFILE=1048576
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexxus-node

# Security Sandboxing
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
# Демон правит собственный конфиг (дашборд → /api/config → запись сюда),
# поэтому каталог конфигурации тоже должен быть доступен на запись.
# Исключение точечное: /etc/nexxus, а не весь /etc.
# В systemd повторный ReadWritePaths перекрывает предыдущий, поэтому
# оба пути перечисляем в одной директиве.
ReadWritePaths=/var/lib/nexxus /etc/nexxus

[Install]
WantedBy=multi-user.target
